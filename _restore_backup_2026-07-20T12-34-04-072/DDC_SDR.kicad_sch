	(text "Hold FPGA in reset while the pico is coming up.\nThis was GPIO31.  Make sure to change it in \nthe MicroPython code. Also remove the clock to\nthe FPGA. There is now no SRAM.  CDONE is now\nGPIO21."
		(exclude_from_sim no)
		(at 66.04 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3166d3a9-05e6-4c91-bf0a-5ca65960ba4e")
	)
	(text "Note:\nBank 2 is selectable IO voltage!\nTo select non-3.3V, cut the shorted jumper\nand supply external voltage (1.8-3.3V) on\nVIO_BANK_2."
		(exclude_from_sim no)
		(at 223.52 88.392 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "33a31de0-ab75-40e1-a47f-b71fef606ab7")
	)
	(text "LRCK pin must be BCK pin +1"
		(exclude_from_sim no)
		(at 34.544 96.774 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3431f291-6512-4eeb-9546-144b0019046d")
	)
	(text "FPGA Banks"
		(exclude_from_sim no)
		(at 202.692 27.94 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "372375a1-5f1a-4fce-b85d-c4e4346c8f56")
	)
	(text "If you are using a real\nPico, this jumper bridges\na Schottky diode\nfrom USB in to Vsys\n(4.7v with it open,\n5.0v from USB port\nwith it soldered)"
		(exclude_from_sim no)
		(at 57.912 12.192 0)
		(effects

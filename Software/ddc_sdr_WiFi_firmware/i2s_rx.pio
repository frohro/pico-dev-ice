;
; I2S slave receiver for the Dev-iCE FPGA audio output.
;
; The FPGA is the I2S master. It drives RX_DATA, BCK, and WS on the Pico
; GPIOs 14, 15, and 16 respectively. The serial format is standard Philips
; I2S: WS changes at the channel boundary, then the new MSB is presented on
; the following BCK falling edge and sampled on the next BCK rising edge.
;
.program i2s_rx

.wrap_target
    wait 1 pin 2            ; Ensure WS is HIGH first (sync anchor: avoids mid-frame start)
    wait 0 pin 2            ; Wait for WS falling edge (Left / I boundary)

    set x, 31
left_loop:
    wait 0 pin 1            ; Wait for BCK LOW
    wait 1 pin 1            ; Sample DATA on BCK rising edge
    in pins, 1
    jmp x-- left_loop

    wait 1 pin 2            ; Wait for WS rising edge (Right / Q boundary)

    set x, 31
right_loop:
    wait 0 pin 1            ; Wait for BCK LOW
    wait 1 pin 1            ; Sample DATA on BCK rising edge
    in pins, 1
    jmp x-- right_loop
.wrap

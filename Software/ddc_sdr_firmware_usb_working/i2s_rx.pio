;
; Left-Justified (LJ) I2S slave receiver for FPGA audio output.
;
; The FPGA is the I2S master. It drives RX_DATA, BCK, and WS on Pico
; GPIOs 14, 15, and 16 respectively. 
;
; Format: Left-Justified (MSB-first, 32 bits per channel)
;   - Left channel:  WS = 1 (HIGH)
;   - Right channel: WS = 0 (LOW)
;   - Timing: 0-bit delay (MSB is sampled on the 1st rising edge of BCK after WS)
;
.program i2s_rx

.wrap_target
    wait 0 pin 2            ; Sync anchor: Ensure WS is LOW first (avoids starting mid-frame)
    wait 1 pin 2            ; Wait for WS rising edge (Left / I channel start)

    set x, 31
left_loop:
    wait 0 pin 1            ; Wait for BCK LOW
    wait 1 pin 1            ; Sample DATA on BCK rising edge (1st edge = MSB, no delay)
    in pins, 1
    jmp x-- left_loop

    wait 0 pin 2            ; Wait for WS falling edge (Right / Q channel start)

    set x, 31
right_loop:
    wait 0 pin 1            ; Wait for BCK LOW
    wait 1 pin 1            ; Sample DATA on BCK rising edge (1st edge = MSB, no delay)
    in pins, 1
    jmp x-- right_loop
.wrap
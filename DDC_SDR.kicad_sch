		(uuid "087ac302-7e64-493b-8332-e32d8120e2e8")
	)
	(text "Top Edge (Near the corner):\nPin 37 (G1): 30.72 MHz Clock IN (From Oscillator)\nRight Edge (Going down the side of the chip):\nPin 36: Spare (Perfect for a test point or interrupt)\nPin 35 (G0): ADC Clock OUT\nPin 34: ADC_D7 (MSB)\nPin 33: (VCCIO_0 - Power Via)\nPin 32: ADC_D6\nPin 31: ADC_D5\nPin 30: (VCC - Power Via)\nPin 29: (VCCPLL - Power Via)\nPin 28: ADC_D4\nPin 27: ADC_D3\nPin 26: ADC_D2\nPin 25: ADC_D1\nPin 24: (VPP_2V5 - Power Via)\nBottom Edge (Right corner):\nPin 23: ADC_D0 (LSB)"
		(exclude_from_sim no)
		(at 124.46 71.628 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "19ea0e48-c165-4adc-9a4b-68dbd10d4c4f")
	)
	(text "Bank 1"
		(exclude_from_sim no)
		(at 306.07 38.1 0)
		(effects

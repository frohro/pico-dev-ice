	)
	(text "Hold FPGA in reset while the pico is coming up.\nThis was GPIO31.  Make sure to change it in \nthe MicroPython code. Also remove the clock to\nthe FPGA. There is now no SRAM.  CDONE is now\nGPIO21."
		(exclude_from_sim no)
		(at 122.936 102.362 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3166d3a9-05e6-4c91-bf0a-5ca65960ba4e")
	)
	(text "Note:\nBank 2 is selectable IO voltage!\nTo select non-3.3V, cut the shorted jumper\nand supply external voltage (1.8-3.3V) on\nVIO_BANK_2."
		(exclude_from_sim no)
		(at 274.32 88.392 0)
